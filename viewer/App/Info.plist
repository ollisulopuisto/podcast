<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>NHSX Viewer</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <!-- XcodeGen tuotti nämä ennen itse. Nyt plist on käsin kirjoitettu, ja
       se joka omistaa tiedoston omistaa myös oletukset: ilman
       `CFBundleExecutable`ia paketissa ei ole mitään käynnistettävää, ja
       Finder ilmoittaa vain ettei sovellusta voi avata. -->
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Versio tulee käännösasetuksista. Ilman **näitä avaimia** asetus ei
       päädy mihinkään: `MARKETING_VERSION` on olemassa, `sed` asettaa sen
       tagista, Xcode kääntää — ja paketissa lukee `1.0`, koska plistissä ei
       ollut paikkaa johon se sijoitettaisiin.
       
       Niin kävi julkaisussa `viewer-v2026.8.28.1`: kaikki vihreänä,
       molemmat paketit `CFBundleShortVersionString 1.0`, `CFBundleVersion 1`.
       macOS päättää päivitystarjouksen `CFBundleVersion`ista, joten
       jumiin jäänyt numero epäonnistuu tekemällä ei mitään. -->
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>

  <!-- `.nhsx` ei ole järjestelmän tuntema tyyppi. Se **tuodaan** eikä
       viedä: tiedostomuoto on Hindenburgin, ei tämän sovelluksen, ja
       viety määrittely väittäisi omistajuutta. Jos Hindenburg itse
       julistaa saman päätteen toisella tunnisteella, järjestelmä
       suosii sitä — ks. README, siellä on komento jolla oikean
       tunnisteen näkee omalta koneelta. -->
  <!-- Sovellus avaa `.nhsx`:n: kaksoisklikkaus Finderissä tulee tänne, ja
       ilman tätä macOS ei tiedä että se osaa. `Viewer`-rooli eikä `Editor`,
       koska tämä ei kirjoita istuntoa. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Hindenburg-istunto</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.hindenburg.nhsx</string>
      </array>
    </dict>
  </array>

  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.hindenburg.nhsx</string>
      <key>UTTypeDescription</key>
      <string>Hindenburg-istunto</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.xml</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nhsx</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
