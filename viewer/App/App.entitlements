<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sama hiekkalaatikko kuin laajennuksella. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Sovellus **avaa tiedostoja**, toisin kuin aiempi tynkä joka ei tehnyt
       mitään. Ilman tätä Arkisto → Avaa… ja tiedoston pudottaminen
       epäonnistuisivat hiljaa hiekkalaatikon estäminä. -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>

  <!-- Sama poikkeus kuin laajennuksella, samasta syystä: NSOpenPanel antaa
       pääsyn **valittuun tiedostoon**, ei sen sisaruksiin, joten pelkkä
       `.nhsx`:n avaaminen ei riitä äänipoolin lukemiseen. Ks. laajennuksen
       `NhsxQuickLook.entitlements`, jossa perustelu ja hinta kokonaan. -->
  <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
  <array>
    <string>/Users/</string>
    <string>/Volumes/</string>
  </array>
</dict>
</plist>
