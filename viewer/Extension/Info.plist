<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>NHSX Quick Look</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <!-- XcodeGen tuotti nämä ennen itse. Nyt plist on käsin kirjoitettu, ja
       se joka omistaa tiedoston omistaa myös oletukset: ilman
       `CFBundleExecutable`ia paketissa ei ole mitään käynnistettävää, ja
       Finder ilmoittaa vain ettei sovellusta voi avata. -->
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- Versio tulee käännösasetuksista. Ilman **näitä avaimia** asetus ei
       päädy mihinkään: `MARKETING_VERSION` on olemassa, `sed` asettaa sen
       tagista, Xcode kääntää — ja paketissa lukee `1.0`, koska plistissä ei
       ollut paikkaa johon se sijoitettaisiin.
       
       Niin kävi julkaisussa `viewer-v2026.8.28.1`: kaikki vihreänä,
       molemmat paketit `CFBundleShortVersionString 1.0`, `CFBundleVersion 1`.
       macOS päättää päivitystarjouksen `CFBundleVersion`ista, joten
       jumiin jäänyt numero epäonnistuu tekemällä ei mitään. -->
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.quicklook.preview</string>
    <key>NSExtensionPrincipalClass</key>
    <string>NhsxQuickLook.PreviewViewController</string>
    <key>NSExtensionAttributes</key>
    <dict>
      <!-- Mitä tämä osaa näyttää. Ks. README: `.nhsx`:n tyyppitunniste ei
           ole järjestelmän tuntema, joten sovellus tuo sen itse. -->
      <key>QLSupportedContentTypes</key>
      <array>
        <string>com.hindenburg.nhsx</string>
      </array>
      <!-- Istunto luetaan kerralla eikä säikeiden kesken jaeta. -->
      <key>QLSupportsSearchableItems</key>
      <false/>
    </dict>
  </dict>
</dict>
</plist>
