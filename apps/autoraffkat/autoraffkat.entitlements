<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ääniketju kääntää silmukkansa numballa. llvmlite varaa suoritettavaa
       muistia (MAP_JIT), ja hardened runtime tappaa prosessin
       (CODESIGNING, Invalid Page) ilman näitä kahta.
       Tarkoituksella ei disable-library-validation: kolmannen osapuolen
       liitännäisen lataus voi tarvita sitä, mutta sitä ei ole todistettu. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
