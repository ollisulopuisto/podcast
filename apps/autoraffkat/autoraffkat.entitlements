<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ääniketju kääntää silmukkansa numballa. llvmlite varaa suoritettavaa
       muistia (MAP_JIT), ja hardened runtime tappaa prosessin
       (CODESIGNING, Invalid Page) ilman näitä kahta. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Niputetut dylibit (libllvmlite, pedalboard, numpy) ovat PyInstallerin
       allekirjoittamia samalla tunnuksella, mutta kirjastovalidointi
       kaatuu helposti kun ne ladataan ctypesillä. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
